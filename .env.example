APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=universal_api
DB_USERNAME=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

# AWS / S3 Configuration for Logs and HA Config
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
CONFIG_S3_BUCKET=
CONFIG_S3_KEY=
LOG_S3_BUCKET=

# Security
TRUSTED_PROXIES=*
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Security Access Control
# Strategies: ALLOW_ALL, WHITELIST (Deny all except listed)
SECURITY_ACCESS_STRATEGY=ALLOW_ALL
SECURITY_ALLOWED_IPS=
